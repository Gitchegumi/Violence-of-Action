[node name="SetupFields" type="VBoxContainer" parent="SetupDialog"]
custom_minimum_size = Vector2(360, 130)
layout_mode = 2
theme_override_constants/separation = 10

[node name="PlayerCountLabel" type="Label" parent="SetupDialog/SetupFields"]
layout_mode = 2
text = "Players"

[node name="PlayerCountOption" type="OptionButton" parent="SetupDialog/SetupFields"]
layout_mode = 2
item_count = 2
popup/item_0/text = "2 Players"
popup/item_0/id = 2
popup/item_1/text = "3 Players"
popup/item_1/id = 3

[node name="SeedLabel" type="Label" parent="SetupDialog/SetupFields"]
layout_mode = 2
text = "Map Seed (optional integer)"

[node name="SeedInput" type="LineEdit" parent="SetupDialog/SetupFields"]
layout_mode = 2
